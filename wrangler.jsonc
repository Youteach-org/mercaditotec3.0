// startup-eval-fix-deploy
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mercaditotec3-0",
  "main": "cloudflare-runtime-entry.mjs",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat", "allow_eval_during_startup"],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "ratelimits": [{
    "name": "API_RATE_LIMITER",
    "namespace_id": "651367375320",
    "simple": { "limit": 3000, "period": 60 }
  }],
  "observability": {
    "enabled": true
  },
  "secrets": {
    "required": ["FIREBASE_SERVICE_ACCOUNT_JSON"]
  }
}
