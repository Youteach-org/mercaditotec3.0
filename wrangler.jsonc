// startup-eval-fix-deploy
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mercaditotec3-0",
  "main": "cloudflare-runtime-entry.mjs",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat", "allow_eval_during_startup"],
  "workers_dev": true,
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "triggers": { "crons": ["0 10 * * *"] },
  "preview_urls": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "651367375320",
      "simple": { "limit": 3000, "period": 60 }
    },
    {
      "name": "AUTH_API_RATE_LIMITER",
      "namespace_id": "651367375321",
      "simple": { "limit": 180, "period": 60 }
    },
    {
      "name": "API_IP_SAFETY_LIMITER",
      "namespace_id": "651367375322",
      "simple": { "limit": 20000, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true
  },
  "secrets": {
    "required": ["FIREBASE_SERVICE_ACCOUNT_JSON"]
  }
}
