rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if owns(uid);

      // Role, verification, trust and moderation fields are server-owned.
      allow create, update, delete: if false;

      match /images/{imageId} {
        allow read: if owns(uid);
        allow create, update: if owns(uid)
          && request.resource.data.keys().hasOnly([
            "url",
            "createdAt",
            "source",
            "shared",
            "sha256",
            "originalOwnerUid"
          ])
          && request.resource.data.url is string
          && request.resource.data.url.size() <= 2048;
        allow delete: if owns(uid);
      }

      match /endorsements/{endorserUid} {
        allow read, write: if false;
      }

      match /trust_counters/{periodId} {
        allow read, write: if false;
      }
    }

    match /messages/{messageId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /message_reactions/{reactionId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          "messageId",
          "userId",
          "emoji",
          "createdAt"
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.messageId is string
        && request.resource.data.emoji in ["👍", "❤️", "😂", "😮", "😢", "🔥"];
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          "messageId",
          "userId",
          "emoji",
          "createdAt"
        ])
        && request.resource.data.messageId is string
        && request.resource.data.emoji in ["👍", "❤️", "😂", "😮", "😢", "🔥"];
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /public_profiles/{uid} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
